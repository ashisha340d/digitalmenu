@echo off
title Digital Menu
echo.
echo  ============================================
echo   Digital Menu - Starting...
echo  ============================================
echo.

:: Check if Python is installed
python --version >nul 2>&1
if errorlevel 1 (
    echo  ERROR: Python is not installed or not in PATH.
    echo.
    echo  Please install Python from https://www.python.org/downloads/
    echo  Make sure to check "Add Python to PATH" during installation.
    echo.
    pause
    exit /b
)

:: Check if Menu.xlsx exists
if not exist "Menu.xlsx" (
    echo  ERROR: Menu.xlsx not found in this folder!
    echo.
    echo  Make sure Menu.xlsx is in the same folder as this .bat file.
    echo.
    pause
    exit /b
)

:: Make sure openpyxl is available (needed by menu_server.py to read/write Menu.xlsx)
python -c "import openpyxl" >nul 2>&1
if errorlevel 1 (
    echo  Installing required package "openpyxl"...
    python -m pip install --quiet openpyxl
)

echo  Starting local server on http://localhost:8080
echo    Menu admin (edit):     http://localhost:8080/admin.html
echo    Menu board (display):  http://localhost:8080/digital-menu.html
echo  Opening both in your browser...
echo.
echo  [Keep this window open while the menu is displayed]
echo  [Press CTRL+C to stop the server]
echo.

:: Open both pages shortly after the server is up
start "" cmd /c "timeout /t 2 /nobreak >nul && start http://localhost:8080/admin.html && timeout /t 1 /nobreak >nul && start http://localhost:8080/digital-menu.html"

:: Start the menu server (serves static files + the /api/menu and /api/upload-image APIs)
python menu_server.py
